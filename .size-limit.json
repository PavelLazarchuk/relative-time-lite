[
    {
        "name": "relative-time-lite",
        "path": "dist/index.js",
        "limit": "2.3 kB",
        "gzip": true
    },
    {
        "name": "relative-time-lite (cjs)",
        "path": "dist/index.cjs",
        "limit": "2.4 kB",
        "gzip": true
    },
    {
        "name": "tree-shaking: { relativeTime } only",
        "path": "dist/index.js",
        "import": "{ relativeTime }",
        "limit": "1.3 kB",
        "gzip": true
    },
    {
        "name": "tree-shaking: { selectUnit } only",
        "path": "dist/index.js",
        "import": "{ selectUnit }",
        "limit": "780 B",
        "gzip": true
    },
    {
        "name": "relative-time-lite/react",
        "path": "dist/react/index.js",
        "import": "{ useRelativeTime }",
        "limit": "2.6 kB",
        "gzip": true,
        "ignore": ["react"]
    }
]
